# Optional real LLM provider for apps/demo-agent (off by default; uses deterministic ScriptedModel when unset)
# DRAWBRIDGE_PROVIDER=gemini
# GEMINI_API_KEY=
# DRAWBRIDGE_MODEL=gemini-2.5-flash

# Optional LLM judge (adds evidence to trace, never overrides a policy rule)
# DRAWBRIDGE_JUDGE_ENABLED=false
