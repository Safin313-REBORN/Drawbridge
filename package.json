{
  "name": "drawbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source firewall that stops AI agents from obeying hidden instructions in untrusted text.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @drawbridge/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages apps --ext .ts,.tsx"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
